<mxCell id="cn" value="HTTP/JSON · X-Request-ID ·&lt;br&gt;X-Consumer-Id" style="text;html=1;fontSize=10;fontColor=#555555;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="vs"><mxGeometry x="15" y="585" width="190" height="30" as="geometry"/></mxCell>
<mxCell id="int" value="Intent Service (FastAPI · Docker) · consumer of the Segmentation Service" style="swimlane;startSize=28;rounded=1;fontStyle=1;fontSize=14;html=1;fillColor=#fdf0e6;strokeColor=#d79b00;swimlaneFillColor=#fdf0e6;" vertex="1" parent="1"><mxGeometry x="280" y="60" width="780" height="290" as="geometry"/></mxCell>
<mxCell id="ix" value="&lt;b&gt;InteractionService (orchestrator)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Receives each client message and runs classification and the segment lookup in parallel.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;spacing=8;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="int"><mxGeometry x="20" y="40" width="740" height="50" as="geometry"/></mxCell>
<mxCell id="icl" value="&lt;b&gt;Intent Classifier&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Works out what the client is asking for from the text of their message.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;spacing=8;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="int"><mxGeometry x="20" y="110" width="235" height="80" as="geometry"/></mxCell>
<mxCell id="isa" value="&lt;b&gt;Sentiment Analyzer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Scores whether the message is positive, neutral, or negative.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;spacing=8;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="int"><mxGeometry x="272" y="110" width="235" height="80" as="geometry"/></mxCell>
<mxCell id="isc" value="&lt;b&gt;Segment Client&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Fetches the same client&#x27;s segments from the Segmentation Service API.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;spacing=8;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="int"><mxGeometry x="525" y="110" width="235" height="80" as="geometry"/></mxCell>
<mxCell id="irp" value="&lt;b&gt;Routing Policy Engine&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Combines intent, sentiment, and segments into one routing decision for the channel.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="int"><mxGeometry x="20" y="210" width="740" height="60" as="geometry"/></mxCell>
<mxCell id="css" value="Segmentation Service (FastAPI · Docker)" style="swimlane;startSize=28;rounded=1;fontStyle=1;fontSize=14;html=1;fillColor=#eef4fb;strokeColor=#6c8ebf;swimlaneFillColor=#eef4fb;" vertex="1" parent="1"><mxGeometry x="280" y="400" width="780" height="300" as="geometry"/></mxCell>
<mxCell id="api" value="&lt;b&gt;① API layer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Accepts segment and rule-set requests from other services and validates them against the API contract.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;spacing=8;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="css"><mxGeometry x="20" y="40" width="740" height="50" as="geometry"/></mxCell>
<mxCell id="svc" value="&lt;b&gt;② SegmentationService (orchestrator)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Runs each request end to end, loading only the client data it needs straight from MongoDB.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="css"><mxGeometry x="20" y="110" width="740" height="50" as="geometry"/></mxCell>
<mxCell id="fac" value="&lt;b&gt;③ Fact Deriver&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Turns the client&#x27;s raw records into the facts rules read, such as age and qualifying balance.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;spacing=8;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="css"><mxGeometry x="20" y="180" width="235" height="95" as="geometry"/></mxCell>
<mxCell id="eng" value="&lt;b&gt;④ Rule Engine&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Applies the active rule set to the facts to assign the client&#x27;s segments.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="css"><mxGeometry x="272" y="180" width="235" height="95" as="geometry"/></mxCell>
<mxCell id="reg" value="&lt;b&gt;Rule-Set Registry&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Supplies the versioned segmentation rules from MongoDB, starting from 02-segmentation-groups.pdf.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="css"><mxGeometry x="525" y="180" width="235" height="95" as="geometry"/></mxCell>
<mxCell id="db" value="&lt;b&gt;MongoDB 7&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;single-node replica set · source of truth&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;div style=&quot;text-align:left;font-size:11px&quot;&gt;&lt;b&gt;Profile&lt;/b&gt;: clients&lt;br&gt;&lt;b&gt;Accounts&lt;/b&gt;: accounts&lt;br&gt;&lt;b&gt;Engagement&lt;/b&gt;: engagement&lt;br&gt;&lt;b&gt;Advice&lt;/b&gt;: advice&lt;br&gt;――――――――――&lt;br&gt;&lt;b&gt;Rules&lt;/b&gt;: rulesets, settings&lt;br&gt;&lt;b&gt;Ingest log&lt;/b&gt;: ingestion_runs, ingestion_issues&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=18;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1120" y="420" width="290" height="280" as="geometry"/></mxCell>
<mxCell id="ing" value="&lt;b&gt;Ingest script&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Validates the client data and rule set and loads them into MongoDB (scripts/ingest.py).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;spacing=8;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;" vertex="1" parent="1"><mxGeometry x="1120" y="740" width="290" height="70" as="geometry"/></mxCell>
