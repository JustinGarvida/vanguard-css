<mxCell id="resp" value='&lt;div style="text-align:left"&gt;&lt;b&gt;Uniform response: every family returns the same FamilyResult&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face="Courier New" style="font-size:11px"&gt;"segments": {&lt;br&gt;&amp;nbsp;&amp;nbsp;"SERVICE_TIER": {"status":"ASSIGNED","values":["FLAGSHIP"]},&lt;br&gt;&amp;nbsp;&amp;nbsp;"LIFE_STAGE": {"status":"OTHER","values":[],"reason":"MISSING_DOB"},&lt;br&gt;&amp;nbsp;&amp;nbsp;"ENGAGEMENT": {"status":"NONE","values":[]},&lt;br&gt;&amp;nbsp;&amp;nbsp;"OPPORTUNITY": {"status":"ASSIGNED","values":["ROLLOVER_CANDIDATE"]}&lt;br&gt;}, "signals": {...}, "dataQuality": [...], "ruleSetVersion": "1.0.0"&lt;/font&gt;&lt;br&gt;&lt;br&gt;Membership check, same for every family: &lt;font face="Courier New"&gt;"FLAGSHIP" in segments.SERVICE_TIER.values&lt;/font&gt;&lt;/div&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf5e7;strokeColor=#82b366;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="280" y="520" width="560" height="200" as="geometry"/></mxCell>
