<mxfile host="app.diagrams.net" agent="Claude Code" version="24.7.17">
  <diagram id="css-architecture" name="Segment retrieval">
    <mxGraphModel dx="1400" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1360" pageHeight="1060" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="&lt;b&gt;Centralized Client Segmentation Service: segment retrieval (v1, compute on request)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="40" y="0" width="900" height="30" as="geometry" />
        </mxCell>

        <!-- Consumers -->
        <mxCell id="consumers" value="Consumers" style="swimlane;startSize=26;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="190" height="230" as="geometry" />
        </mxCell>
        <mxCell id="apps" value="&lt;b&gt;Digital apps&lt;/b&gt;&lt;br&gt;web, mobile, contact center" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="consumers">
          <mxGeometry x="15" y="45" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="dash" value="&lt;b&gt;Demo dashboard&lt;/b&gt;&lt;br&gt;React" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="consumers">
          <mxGeometry x="15" y="140" width="160" height="70" as="geometry" />
        </mxCell>

        <!-- CSS container -->
        <mxCell id="css" value="Segmentation Service (FastAPI, containerized)" style="swimlane;startSize=26;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="270" y="60" width="740" height="640" as="geometry" />
        </mxCell>
        <mxCell id="api" value="&lt;b&gt;API layer&lt;/b&gt;&lt;br&gt;GET /v1/clients/{clientId}/segments&lt;br&gt;POST /v1/segments:batch&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;?asOfDate ?ruleSetVersion ?families ?explain&lt;br&gt;400 bad id · 404 no profile&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="css">
          <mxGeometry x="30" y="50" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="agg" value="&lt;b&gt;Aggregator&lt;/b&gt;&lt;br&gt;async httpx + asyncio.gather&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;profile first (existence check),&lt;br&gt;then accounts / engagement / advice&lt;br&gt;upstream 404 → record missing&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="css">
          <mxGeometry x="490" y="50" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="val" value="&lt;b&gt;Validator / Normalizer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Decimal money parsing&lt;br&gt;null / invalid / under-22 DOB checks&lt;br&gt;cross-field conflicts → DataQuality notes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="css">
          <mxGeometry x="490" y="230" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="facts" value="&lt;b&gt;Fact Deriver&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;age @ asOfDate&lt;br&gt;qualifyingBalance (OPEN, primary owner)&lt;br&gt;heldOpenAccountTypes (any owner)&lt;br&gt;daysSinceLogin&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="css">
          <mxGeometry x="490" y="390" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="engine" value="&lt;b&gt;Rule Engine (pure function)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;no I/O, no clock reads&lt;br&gt;THRESHOLD_BANDS · VALUE_MAP&lt;br&gt;RANGE_BANDS · PREDICATES&lt;br&gt;exclusive families first, then OPPORTUNITY&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="css">
          <mxGeometry x="260" y="390" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="rules" value="&lt;b&gt;rulesets/v1.0.0.json&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;versioned, immutable&lt;br&gt;schema-validated at startup&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="css">
          <mxGeometry x="270" y="540" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="resp" value="&lt;b&gt;Response Builder&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;uniform FamilyResult per family&lt;br&gt;apply ?families filter (output only)&lt;br&gt;add facts + trace if ?explain=true&lt;br&gt;stamp ruleSetVersion, asOfDate&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="css">
          <mxGeometry x="30" y="390" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="nlp" value="&lt;b&gt;Intent &amp;amp; Sentiment&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;POST /v1/interactions:classify&lt;br&gt;(separate router; not on segment path)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#666666;dashed=1;" vertex="1" parent="css">
          <mxGeometry x="30" y="230" width="200" height="70" as="geometry" />
        </mxCell>

        <!-- Mock upstreams -->
        <mxCell id="ups" value="Mock upstreams (FastAPI, own container)" style="swimlane;startSize=26;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="1060" y="60" width="250" height="420" as="geometry" />
        </mxCell>
        <mxCell id="prof" value="&lt;b&gt;Profile&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;profiles.json · system of record for existence&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="ups">
          <mxGeometry x="25" y="45" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="acct" value="&lt;b&gt;Accounts&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;accounts.json&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="ups">
          <mxGeometry x="25" y="135" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="engm" value="&lt;b&gt;Engagement&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;engagement.json&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="ups">
          <mxGeometry x="25" y="215" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="adv" value="&lt;b&gt;Advice&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;advice.json&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="ups">
          <mxGeometry x="25" y="295" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="upsnote" value="GET /{resource}/{clientId}&lt;br&gt;200 record · 404 none" style="text;html=1;align=center;fontSize=10;fontColor=#666666;" vertex="1" parent="ups">
          <mxGeometry x="25" y="370" width="200" height="35" as="geometry" />
        </mxCell>

        <!-- Edges: request path -->
        <mxCell id="e1" value="1. GET segments" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="apps" target="api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e1b" value="batch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="dash" target="api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="2. fetch(clientId)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="api" target="agg">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3a" value="3. profile first" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;startArrow=block;strokeColor=#9673a6;" edge="1" parent="1" source="agg" target="prof">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3b" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;startArrow=block;strokeColor=#9673a6;dashed=1;" edge="1" parent="1" source="agg" target="acct">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3c" value="parallel" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;startArrow=block;strokeColor=#9673a6;dashed=1;" edge="1" parent="1" source="agg" target="engm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3d" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;startArrow=block;strokeColor=#9673a6;dashed=1;" edge="1" parent="1" source="agg" target="adv">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="4. raw records (or missing)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="agg" target="val">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="5. normalized + notes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="val" target="facts">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="6. facts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="facts" target="engine">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6r" value="rule set" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;strokeColor=#d6b656;" edge="1" parent="1" source="rules" target="engine">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="7. FamilyResults&lt;br&gt;+ traces" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="engine" target="resp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="8. response JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;strokeColor=#82b366;strokeWidth=2;exitX=0.25;exitY=0;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="resp" target="api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" value="9. 200 / 400 / 404" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;strokeColor=#82b366;strokeWidth=2;dashed=1;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="api" target="apps">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Response contract -->
        <mxCell id="contract" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;Response contract: uniform FamilyResult (every family, same shape)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; style=&quot;font-size:11px&quot;&gt;{&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;clientId&quot;: &quot;C-100197&quot;, &quot;asOfDate&quot;: &quot;2026-10-01&quot;, &quot;ruleSetVersion&quot;: &quot;1.0.0&quot;, &quot;evaluatedAt&quot;: &quot;…&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;segments&quot;: {&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;SERVICE_TIER&quot;: { &quot;status&quot;: &quot;ASSIGNED&quot;, &quot;values&quot;: [&quot;STANDARD&quot;] },&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;LIFE_STAGE&quot;:&amp;nbsp;&amp;nbsp; { &quot;status&quot;: &quot;OTHER&quot;,&amp;nbsp;&amp;nbsp;&amp;nbsp; &quot;values&quot;: [], &quot;reason&quot;: &quot;MISSING_DOB&quot; },&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;ENGAGEMENT&quot;:&amp;nbsp;&amp;nbsp; { &quot;status&quot;: &quot;NONE&quot;,&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &quot;values&quot;: [] },&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;OPPORTUNITY&quot;:&amp;nbsp; { &quot;status&quot;: &quot;ASSIGNED&quot;, &quot;values&quot;: [&quot;EDUCATION_SAVER&quot;] }, …&lt;br&gt;&amp;nbsp;&amp;nbsp;},&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;signals&quot;: { &quot;daysSinceLogin&quot;: 22 },&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;dataQuality&quot;: [ … ]&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;// + &quot;facts&quot; and per-family &quot;trace&quot; only when ?explain=true&lt;br&gt;}&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;status&lt;/b&gt;: ASSIGNED (values non-empty) · NONE (no segment applies, not an error) · OTHER (key data missing/unmapped, see reason)&lt;br&gt;Consumers check membership the same way for every family: &lt;font face=&quot;Courier New&quot;&gt;&quot;FLAGSHIP&quot; in segments.SERVICE_TIER.values&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="730" width="1270" height="300" as="geometry" />
        </mxCell>

        <!-- Legend -->
        <mxCell id="legend" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;solid black: request path (numbered)&lt;br&gt;green: response path&lt;br&gt;purple dashed: parallel upstream calls&lt;br&gt;yellow: rules as data&lt;br&gt;grey dashed: outside segment path&lt;br&gt;&lt;br&gt;&lt;b&gt;Future (not built):&lt;/b&gt; precompute store keyed by&lt;br&gt;(clientId, ruleSetVersion, asOfDate), reusing the same pure engine.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;align=left;verticalAlign=top;spacing=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1060" y="510" width="250" height="190" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
