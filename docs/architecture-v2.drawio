<mxfile host="app.diagrams.net" agent="Claude Code" version="24.7.17">
  <diagram id="intent-v2" name="v2: Intent Service + Segmentation Service">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1420" pageHeight="920" math="0" shadow="0">
      <root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="t" value="&lt;b&gt;v2 (future extension): Intent Service consuming the Segmentation Service&lt;/b&gt;" style="text;html=1;fontSize=18;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="1000" height="30" as="geometry"/></mxCell>
<mxCell id="ch" value="Client-facing channels" style="swimlane;startSize=28;rounded=1;fontStyle=1;fontSize=14;fillColor=#f5f5f5;strokeColor=#666666;swimlaneFillColor=#f5f5f5;" vertex="1" parent="1"><mxGeometry x="30" y="60" width="210" height="230" as="geometry"/></mxCell>
<mxCell id="c1" value="&lt;b&gt;Contact-center chat&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="ch"><mxGeometry x="15" y="40" width="180" height="45" as="geometry"/></mxCell>
<mxCell id="c2" value="&lt;b&gt;Web / mobile assistant&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="ch"><mxGeometry x="15" y="95" width="180" height="45" as="geometry"/></mxCell>
<mxCell id="c3" value="Demo dashboard (FR-18)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontColor=#555555;" vertex="1" parent="ch"><mxGeometry x="15" y="150" width="180" height="45" as="geometry"/></mxCell>
<mxCell id="models" value='&lt;b&gt;models/&lt;/b&gt;&lt;br&gt;&lt;font face="Courier New" style="font-size:10px"&gt;intent-0.1.0.joblib&lt;/font&gt;&lt;br&gt;&lt;font face="Courier New" style="font-size:10px"&gt;sentiment-0.1.0.joblib&lt;/font&gt;' style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.2;fillColor=#dbe8f7;strokeColor=#2f6db5;" vertex="1" parent="1"><mxGeometry x="30" y="430" width="210" height="80" as="geometry"/></mxCell>
<mxCell id="steps" value="&lt;b&gt;How a message flows&lt;/b&gt;&lt;br&gt;① Channel sends message + clientId&lt;br&gt;②a Classify text: intent + sentiment&lt;br&gt;②b Fetch segments from the Segmentation Service (in parallel)&lt;br&gt;③ Routing policy combines all three&lt;br&gt;④ Response returned to the channel" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="550" width="220" height="140" as="geometry"/></mxCell>
<mxCell id="isvc" value="Intent Service (FastAPI · Docker) · separate service" style="swimlane;startSize=28;rounded=1;fontStyle=1;fontSize=14;fillColor=#eef4fb;strokeColor=#2f6db5;swimlaneFillColor=#eef4fb;" vertex="1" parent="1"><mxGeometry x="270" y="60" width="740" height="590" as="geometry"/></mxCell>
<mxCell id="api" value='&lt;b&gt;API layer: routers · Pydantic schemas · middleware&lt;/b&gt;&lt;br&gt;&lt;font face="Courier New" style="font-size:10px"&gt;POST /v1/interactions:classify · GET /health · /openapi.json&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2f6db5;" vertex="1" parent="isvc"><mxGeometry x="20" y="40" width="700" height="56" as="geometry"/></mxCell>
<mxCell id="orch" value='&lt;b&gt;InteractionService (orchestrator)&lt;/b&gt;&lt;br&gt;&lt;font face="Courier New" style="font-size:10px"&gt;asyncio.gather(classify(message), segments(clientId)) → route → respond&lt;/font&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="isvc"><mxGeometry x="20" y="112" width="700" height="56" as="geometry"/></mxCell>
<mxCell id="grp" value="②a classification path" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#2f6db5;dashed=1;verticalAlign=top;align=left;fontSize=10;spacingLeft=6;spacingTop=-18;" vertex="1" parent="isvc"><mxGeometry x="12" y="186" width="556" height="190" as="geometry"/></mxCell>
<mxCell id="prep" value='&lt;div style="text-align:left"&gt;&lt;div style="text-align:center"&gt;&lt;b&gt;Text Preprocessor&lt;/b&gt;&lt;/div&gt;&lt;i&gt;Cleans the message before classifying it.&lt;/i&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;• Normalize case + spacing&lt;br&gt;• Fix common typos / slang&lt;br&gt;• Detect Spanish language&lt;br&gt;• Keep the final ask in long messages&lt;/font&gt;&lt;/div&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2f6db5;;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="isvc"><mxGeometry x="20" y="196" width="170" height="170" as="geometry"/></mxCell>
<mxCell id="intent" value='&lt;div style="text-align:left"&gt;&lt;div style="text-align:center"&gt;&lt;b&gt;Intent Classifier&lt;/b&gt;&lt;/div&gt;&lt;i&gt;Maps text to one of 45 catalog intents.&lt;/i&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;• TF-IDF + logistic regression baseline&lt;br&gt;• Top-3 labels + confidence&lt;br&gt;• Confidence &amp;lt; 0.45 → UNKNOWN&lt;br&gt;• Pluggable (LLM later)&lt;/font&gt;&lt;/div&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbe8f7;strokeColor=#2f6db5;;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="isvc"><mxGeometry x="205" y="196" width="170" height="170" as="geometry"/></mxCell>
<mxCell id="sent" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;Sentiment Analyzer&lt;/b&gt;&lt;/div&gt;&lt;i&gt;Scores the tone of the client's message.&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• POSITIVE / NEUTRAL / NEGATIVE + confidence&lt;br&gt;• Detects repeat-contact phrases (&quot;third time&quot;)&lt;br&gt;• Model loaded at startup&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbe8f7;strokeColor=#2f6db5;;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="isvc"><mxGeometry x="390" y="196" width="170" height="170" as="geometry"/></mxCell>
<mxCell id="segc" value='&lt;div style="text-align:left"&gt;&lt;div style="text-align:center"&gt;&lt;b&gt;Segment Client&lt;/b&gt;&lt;/div&gt;&lt;i&gt;Fetches segments from the Segmentation Service (②b, in parallel).&lt;/i&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;• Typed client from its OpenAPI spec&lt;br&gt;• Requests only the families routing needs&lt;br&gt;• Reads FamilyResult&lt;/font&gt;&lt;/div&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="isvc"><mxGeometry x="575" y="196" width="145" height="170" as="geometry"/></mxCell>
<mxCell id="route" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;③ Routing Policy Engine&lt;/b&gt;&lt;/div&gt;&lt;i&gt;Combines intent, sentiment, and segments into one routing decision and escalation flag.&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• Rules as data (routing-policy/v1.json), same versioned pattern as segment rule sets&lt;br&gt;• e.g. ADVICE_INTEREST + ADVICE_PROSPECT → advice-lead queue&lt;br&gt;• e.g. ADVICE_INTEREST + HUMAN_ADVISED → the client's own advisor&lt;br&gt;• escalationSuggested: NEGATIVE ≥ 0.7, or TALK_TO_HUMAN / COMPLAINT / FRAUD_REPORT / REPORT_DEATH&lt;br&gt;• FLAGSHIP / FLAGSHIP_SELECT tiers → tier-appropriate service channel&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="isvc"><mxGeometry x="20" y="420" width="700" height="150" as="geometry"/></mxCell>
<mxCell id="css" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;Segmentation Service (v1)&lt;/b&gt;&lt;/div&gt;&lt;i&gt;this build · unchanged by v2 · returns a client's segments for any caller&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• GET /v1/clients/{id}/segments?families=SERVICE_TIER,ADVICE,OPPORTUNITY,ENGAGEMENT&lt;br&gt;• Uniform FamilyResult per family + signals&lt;br&gt;• The Intent Service is just another consumer&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4fb;strokeColor=#6c8ebf;;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1060" y="200" width="310" height="170" as="geometry"/></mxCell>
<mxCell id="db" value='&lt;b&gt;MongoDB&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;client data + segment rule sets&lt;/font&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;(never read by the Intent Service)&lt;/font&gt;' style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=18;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;" vertex="1" parent="1"><mxGeometry x="1100" y="400" width="230" height="140" as="geometry"/></mxCell>
<mxCell id="pol" value='&lt;b&gt;routing-policy/v1.json&lt;/b&gt;&lt;br&gt;&lt;font style="font-size:10px"&gt;intent × segment rules · thresholds&lt;/font&gt;' style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.2;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1100" y="570" width="230" height="70" as="geometry"/></mxCell>
<mxCell id="resp" value='&lt;div style="text-align:left"&gt;&lt;b&gt;④ Response: intent + sentiment + the segments used + routing decision&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face="Courier New" style="font-size:11px"&gt;{&lt;br&gt;&amp;nbsp;&amp;nbsp;"intent": {"label":"ADVICE_INTEREST","confidence":0.82,"topK":[...]},&lt;br&gt;&amp;nbsp;&amp;nbsp;"sentiment": {"label":"NEUTRAL","confidence":0.77,"escalationSuggested":false},&lt;br&gt;&amp;nbsp;&amp;nbsp;"segments": {"ADVICE":{"status":"ASSIGNED","values":["SELF_DIRECTED"]},&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;"OPPORTUNITY":{"status":"ASSIGNED","values":["ADVICE_PROSPECT"]}},&lt;br&gt;&amp;nbsp;&amp;nbsp;"routing": {"action":"ADVICE_LEAD_QUEUE","reason":"ADVICE_INTEREST + ADVICE_PROSPECT"},&lt;br&gt;&amp;nbsp;&amp;nbsp;"classifierVersion": "intent-0.1.0", "ruleSetVersion": "1.0.0"&lt;br&gt;}&lt;/font&gt;&lt;br&gt;&lt;br&gt;segments are passed through unchanged from the Segmentation Service (same FamilyResult shape)&lt;/div&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf5e7;strokeColor=#82b366;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="270" y="680" width="740" height="210" as="geometry"/></mxCell>
<mxCell id="ec0" value="① POST /v1/interactions:classify" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="c1" target="api"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="ec1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="c2" target="api"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="ec3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;strokeColor=#333333;dashed=1;strokeColor=#999999;" edge="1" parent="1" source="c3" target="api"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="api" target="orch"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e2" value="②a" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="orch" target="grp"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e3" value="②b in parallel" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="orch" target="segc"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;strokeColor=#333333;strokeColor=#2f6db5;" edge="1" parent="1" source="prep" target="intent"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e5" value="cleaned text" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;strokeColor=#333333;strokeColor=#2f6db5;" edge="1" parent="1" source="prep" target="sent"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e6" value="loaded at startup" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;strokeColor=#333333;dashed=1;strokeColor=#2f6db5;" edge="1" parent="1" source="models" target="grp"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="intent" target="route"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="sent" target="route"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;strokeColor=#333333;strokeColor=#d6b656;" edge="1" parent="1" source="segc" target="route"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e10" value="GET segments ⇄ FamilyResult" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;strokeColor=#333333;startArrow=block;strokeColor=#d6b656;strokeWidth=2;" edge="1" parent="1" source="segc" target="css"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;strokeColor=#333333;strokeColor=#9673a6;" edge="1" parent="1" source="css" target="db"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;strokeColor=#333333;strokeColor=#82b366;" edge="1" parent="1" source="pol" target="route"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e13" value="④" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;strokeColor=#333333;strokeColor=#4d8a42;strokeWidth=2;" edge="1" parent="1" source="isvc" target="resp"><mxGeometry relative="1" as="geometry"/></mxCell>
